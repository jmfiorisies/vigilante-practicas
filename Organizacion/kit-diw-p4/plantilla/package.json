  "description": "DIW · Práctica 4 · Cita Fácil: la web de pedir cita del Consultorio Los Alcatraces, accesible, auditada, usable y verificada",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5191",
    "build": "vite build",

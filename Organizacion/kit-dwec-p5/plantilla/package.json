    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "vite": "8.3.4",
    "vitest": "5.0.5"

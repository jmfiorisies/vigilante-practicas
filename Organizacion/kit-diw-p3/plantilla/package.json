{
  "name": "p3-cine-bahia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DIW · Práctica 3 · Cine Bahía, el cine de verano del barrio (componentes, Storybook e interactividad)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190",
    "build": "vite build",
    "storybook": "storybook dev --port 6006 --host 0.0.0.0 --no-open --ci",
    "build-storybook": "storybook build --quiet",
    "comprobar": "node comprobador/comprobar.mjs",
    "lint": "stylelint \"scss/**/*.scss\" \"src/**/*.scss\"",
    "formato": "prettier --write \"src/**/*.{js,scss}\" \"scss/**/*.scss\" \"*.html\"",
    "formato:comprobar": "prettier --check \"src/**/*.{js,scss}\" \"scss/**/*.scss\" \"*.html\""
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "storybook": "10.6.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "vite": "8.3.5"
  }
}
